    {
      "id": "decisao-acao",
      "name": "Decidir Acao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1560,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const config=$input.first().json;const agora=new Date();const hora=agora.getHours()*60+agora.getMinutes();const modoManual=$execution.mode===\"manual\";const [hi,mi]=(config.inicioEnvios||\"08:00\").split(\":\").map(Number);const [hf,mf]=(config.fimEnvios||\"18:00\").split(\":\").map(Number);const [hr,mr]=(config.horarioResumao||\"19:00\").split(\":\").map(Number);const [hd,md]=(config.horarioEnvioDiario||\"08:00\").split(\":\").map(Number);const p=config.periodicidade||\"intervalo\";let acao=\"nada\";if(modoManual){acao=\"noticias\";}else{if(hora>=hr*60+mr&&hora<hr*60+mr+5){acao=\"resumao\";}else if(p===\"diario\"){if(hora>=hd*60+md&&hora<hd*60+md+5)acao=\"noticias\";}else{if(hora>=hi*60+mi&&hora<=hf*60+mf){const ult=parseInt($env.LAST_NEWS_SEND||\"0\");const int=(config.intervaloMinutos||60)*60000;if(Date.now()-ult>=int)acao=\"noticias\";}}}return[{json:{acao,jobId:$execution.id,config,diaAtual:agora.toISOString().split(\"T\")[0],modoManual,timestamp:Date.now()}}];"
      }
    },
