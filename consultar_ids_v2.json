{
  "name": "Consultar IDs WhatsApp (v2)",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Iniciar Consulta",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "config",
      "name": "Configurar",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "parameters": {
        "assignments": {
          "values": [
            { "name:": "evolutionUrl", "value": "", "type": "string" },
            { "name": "instancia", "value": "", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "consultar",
      "name": "Consultar Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ ($json.evolutionUrl || '').replace(/\\/$/, '') + '/instances' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 },
        "credentials": { "httpHeaderAuth": { "id": "evolution-api", "name": "Evolution API" } }
      }
    },
    {
      "id": "formatar",
      "name": "Formatar Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst instances = resp?.instances || resp?.data || resp || [];\nconst resultado = Array.isArray(instances) ? instances : [instances];\nreturn [{ json: { resultado: resultado.map(i => ({ nome: i.name || i.instanceName, status: i.status || i.connectionStatus, id: i.id })) } }];"
      }
    }
  ],
  "connections": {
    "Iniciar Consulta": { "main": [[{ "node": "Configurar", "type": "main", "index": 0 }]] },
    "Configurar": { "main": [[{ "node": "Consultar Evolution", "type": "main", "index": 0 }]] },
    "Consultar Evolution": { "main": [[{ "node": "Formatar Resultado", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "binaryMode": "separate", "timezone": "America/Sao_Paulo" },
  "versionId": "ids-v2-static",
  "meta": { "instanceId": "financas-iguera-ids-v2" },
  "tags": []
}
