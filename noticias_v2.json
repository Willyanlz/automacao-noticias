          "combinator": "and"
        }
      }
    },
    {
      "id": "preparar-envio",
      "name": "Preparar Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const dados=$input.first().json;const itens=dados.dados.itens;const config=dados.config;return itens.map(item=>{const linkNoticia=item.id&&item.id.startsWith('http')?item.id:(dados.materias?.[0]||'');const texto=(item.emoji||'📰')+' *'+item.titulo+'*\\n\\n'+item.resumo+'\\n\\n'+(config.enviarLinksFontes&&linkNoticia?'🔗 '+linkNoticia:'');return{titulo:item.titulo,texto:texto.trim(),imagemUrl:item.imagem||'',link:linkNoticia,config,modoManual:dados.modoManual,historicoUrl:dados.historicoUrl};});"
      }
    },
