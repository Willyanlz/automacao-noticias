    {
      "id": "extrair-conteudo",
      "name": "Extrair Texto e Imagem",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        -240,
        200
      ],
      "parameters": {
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "titulo",
              "selector": "h1, article h1",
              "returnValue": "text"
            },
            {
              "key": "conteudo",
              "selector": "article p, .article-body p",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "imagem",
              "selector": "article img, .article-body img",
              "returnValue": "attribute",
              "attribute": "src",
              "returnArray": true
            }
          ]
        }
      }
    },
    {
      "id": "montar-prompt",
      "name": "Montar Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const dados=$input.first().json;const config=dados.config||{};const decisao=$('Decidir Acao').first().json;const modoManual=decisao.modoManual;const materias=$input.all().map(item=>{const j=item.json;const c=Array.isArray(j.conteudo)?j.conteudo.join(' '):(j.conteudo||'');const imgs=Array.isArray(j.imagem)?j.imagem:(j.imagem?[j.imagem]:[]);return{titulo:j.titulo||j.title||'',link:j.link||'',conteudo:c.slice(0,2000),imagens:imgs.filter(i=>i&&i.startsWith('http')).slice(0,1)};}).filter(m=>m.conteudo.length>50);if(materias.length===0)return[{json:{semNoticias:true}}];const p='Analise estas noticias e resuma em JSON: {\"tipo\":\"noticias\",\"itens\":[{\"id\":\"link\",\"titulo\":\"...\",\"emoji\":\"📈\",\"resumo\":\"...\"}]}\\n\\n'+materias.map((m,i)=>'['+(i+1)+'] '+m.titulo+'\\n'+m.conteudo+'\\nLink: '+m.link).join('\\n\\n');return[{json:{prompt:p,config,modoManual,historicoUrl:(config.historicoUrl||'http://historico:8090')}}];"
      }
    },
    {
      "id": "gemini-retry",
      "name": "Gemini com Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inp=$input.first().json;const prompt=inp.prompt;const config=inp.config;const modelo=config.modeloGemini||'gemini-2.0-flash';const apiKey=config.geminiApiKey;if(!apiKey)throw new Error('geminiApiKey nao configurada');const maxT=3;let err=null;for(let t=1;t<=maxT;t++){try{const resp=await $http({method:'POST',url:'https://generativelanguage.googleapis.com/v1beta/models/'+modelo+':generateContent?key='+apiKey,headers:{'Content-Type':'application/json'},body:{contents:[{parts:[{text:prompt}]}],generationConfig:{responseMimeType:'application/json',temperature:0.7,maxOutputTokens:2048}}});const txt=resp?.candidates?.[0]?.content?.parts?.[0]?.text;if(!txt)throw new Error('Vazio');const j=JSON.parse(txt);if(!j.tipo||!j.itens)throw new Error('Formato invalido');return[{json:{sucesso:true,dados:j,tentativa:t,config,modoManual:inp.modoManual,historicoUrl:inp.historicoUrl}}];}catch(e){err=e;console.log('T'+t+' falhou:',e.message);if(t<maxT)await new Promise(r=>setTimeout(r,2000*t));}}return[{json:{sucesso:false,erro:err?.message||'Falha',modoManual:inp.modoManual}}];"
      }
    },
    {
      "id": "validar-resposta",
      "name": "Validar Resposta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        420,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.sucesso }}",
              "operator": {
