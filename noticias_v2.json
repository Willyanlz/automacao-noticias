    {
      "id": "filtrar-noticias",
      "name": "Filtrar + Deduplicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const decisao=$(\"Decidir Acao\").first().json;const config=decisao.config;const modoManual=decisao.modoManual;const historicoUrl=config.historicoUrl||\"http://historico:8090\";let noticias=[];for(const item of $input.all()){const j=item.json;if(j.title||j.content)noticias.push({title:j.title||\"\",link:j.link||j.id||\"\",content:j.content||j.contentSnippet||j.summary||\"\"});}if(!modoManual&&noticias.length>0){try{const links=noticias.map(n=>n.link).filter(Boolean);const resp=await $http({method:\"POST\",url:historicoUrl+\"/verifica\",body:{links}});const unicos=resp.links||[];noticias=noticias.filter(n=>unicos.includes(n.link));}catch(e){console.log(\"Erro historico:\",e.message);}}const pk=[\"investimento\",\"mercado\",\"acoes\",\"bolsa\",\"renda fixa\",\"cdb\",\"lci\",\"lca\",\"tesouro\",\"selic\",\"inflacao\",\"ipca\",\"dolar\",\"cripto\",\"bitcoin\",\"fii\",\"fundos\",\"dividendos\",\"petrobras\",\"vale\",\"itau\",\"bradesco\",\"banco central\",\"fed\",\"juros\",\"pib\",\"recessao\",\"alta\",\"queda\"];function rel(t,c){const tx=(t+\" \"+c).toLowerCase();let s=0;for(const p of pk)if(tx.includes(p))s++;return s;}const fil=noticias.map(n=>({...n,r:rel(n.title,n.content)})).filter(n=>n.r>=1).sort((a,b)=>b.r-a.r).slice(0,config.maxNoticias||5);if(fil.length===0)return[{json:{semNoticias:true}}];return fil.map(n=>({json:n}));"
      }
    },
    {
      "id": "buscar-materias",
